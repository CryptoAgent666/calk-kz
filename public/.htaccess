# =============================================
# Calk.kz — SPA на shared hosting (Apache)
# =============================================

# Кастомная 404 страница — важно поставить ДО mod_rewrite
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 редиректы старых slug-ов на актуальные (SEO-сохранение)
  RewriteRule ^calculator/mortgage/?$ /calculator/mortgage-specialized/ [R=301,L]
  RewriteRule ^calculator/notary-services/?$ /calculator/notary/ [R=301,L]
  RewriteRule ^calculator/gas-bill/?$ /calculator/gas/ [R=301,L]
  RewriteRule ^calculator/water-bill/?$ /calculator/water/ [R=301,L]
  RewriteRule ^__kk/calculator/mortgage/?$ /__kk/calculator/mortgage-specialized/ [R=301,L]
  RewriteRule ^__kk/calculator/notary-services/?$ /__kk/calculator/notary/ [R=301,L]
  RewriteRule ^__kk/calculator/gas-bill/?$ /__kk/calculator/gas/ [R=301,L]
  RewriteRule ^__kk/calculator/water-bill/?$ /__kk/calculator/water/ [R=301,L]
  RewriteRule ^embed/mortgage/?$ /embed/mortgage-specialized/ [R=301,L]
  RewriteRule ^embed/notary-services/?$ /embed/notary/ [R=301,L]
  RewriteRule ^embed/gas-bill/?$ /embed/gas/ [R=301,L]
  RewriteRule ^embed/water-bill/?$ /embed/water/ [R=301,L]

  # Не трогаем реально существующие файлы и папки
  RewriteRule ^index\.html$ - [L]
  # SPA-фолбэк — только для клиентских маршрутов без пререндера (история,
  # избранное, напоминания; /search React сам уводит на главную). Всё прочее,
  # чего нет на диске, получает ErrorDocument 404: ту же index.html, но со
  # статусом 404. Раньше здесь стояло «RewriteRule . /index.html» — любой
  # мусорный URL отвечал 200 (soft 404), и ErrorDocument выше не срабатывал.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(__kk/)?(history|favorites|reminders|search)/?$ /index.html [L]
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
  # HSTS: сайт и так только по https, закрепляем на год с поддоменами.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Запрет MIME-sniffing: браузер не должен «додумывать» тип за Content-Type.
  Header always set X-Content-Type-Options "nosniff"
  # Реферер третьим сторонам — только origin, без пути (в путях бывают параметры расчёта).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Явно отключаем сенсоры, которые калькуляторам не нужны.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Защита от кликджекинга — ТОЛЬКО вне /embed/. Виджеты в /embed/ существуют
  # именно ради встраивания на сторонние сайты (132 страницы), запрет фреймов
  # сломал бы продукт.
  #
  # CSP — минимальный, без списков источников скриптов (AdSense, GA, Supabase
  # и шрифты не ломаются): запрет <object>/<embed>-плагинов и подмены <base>;
  # вне /embed/ — ещё frame-ancestors как современная замена X-Frame-Options.
  <If "%{REQUEST_URI} !~ m#^/(__kk/)?embed/#">
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  </If>
  <Else>
    Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'"
  </Else>
</IfModule>

# Кэширование статики
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|avif|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# GZIP сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# CORS для OTA приложения (app-updates/latest.json и bundle-*.zip): манифест
# запрашивает нативное приложение с origin, отличным от сайта. Основной путь
# в клиенте — нативный HTTP (мимо CORS), заголовок — страховка для webview-fetch.
# Файлы с такими именами существуют только в app-updates/.
<IfModule mod_headers.c>
  <FilesMatch "^(latest\.json|bundle-[0-9]+\.zip)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
